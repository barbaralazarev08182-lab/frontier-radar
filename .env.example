# ============================================================================
# Frontier Radar · 环境变量样例
# 规则：仅 NEXT_PUBLIC_* 前缀的变量会暴露给浏览器；其余一律仅服务端。
# 所有密钥只存在服务端环境变量，禁止入库、禁止入 git。
# ============================================================================

# ---- Supabase ----
# 推荐（新变量）：
# Publishable Key 用于浏览器与公开只读查询；Secret Key 仅服务端采集写入。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 兼容（旧变量，新变量缺失时自动回退）：
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 说明：Secret Key / service role key 永远不得进入客户端或日志。

# ---- GitHub REST API ----
# 仅服务端读取；禁止输出 Token 值/部分值/长度，禁止把认证 Header 写入日志。
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# 发现策略（数值可调，行为由 src/config/github-discovery.ts 控制）
GITHUB_DISCOVERY_DAYS=7
GITHUB_SEARCH_PAGES_PER_QUERY=2
GITHUB_SEARCH_PER_PAGE=50
GITHUB_ENRICH_LIMIT=50
GITHUB_REQUEST_TIMEOUT_MS=15000
GITHUB_MAX_RETRIES=3

# 搜索请求预算控制（阶段 1.2.1）
# 单次运行最大 Search API 请求数（含分页）
GITHUB_SEARCH_REQUEST_BUDGET=24
# Search 速率限制保留额度（达到此值时停止发送新搜索请求）
GITHUB_SEARCH_RATE_LIMIT_RESERVE=3
# Core API 速率限制保留额度（README 等请求）
GITHUB_CORE_RATE_LIMIT_RESERVE=50
# 每次运行的查询组上限（按优先级轮换选择）
GITHUB_DISCOVERY_GROUPS_PER_RUN=6

# ---- Hugging Face Hub API（阶段 1.3）----
# 可选；公开内容允许匿名运行。Token 仅服务端读取，禁止输出。
HF_TOKEN=
HF_API_BASE_URL=https://huggingface.co
# 每类内容最大采集数量
HF_DISCOVERY_LIMIT_PER_TYPE=50
# 每类 Card/README enrichment 数量
HF_ENRICH_LIMIT_PER_TYPE=10
# 请求超时 ms
HF_REQUEST_TIMEOUT_MS=15000
# 最大重试次数
HF_MAX_RETRIES=2

# ---- arXiv（阶段 1.4）----
# arXiv 官方 API 无需 Token
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
# 发布时间窗口（天），超过窗口的论文在客户端过滤
ARXIV_DISCOVERY_DAYS=7
# 每个查询的最大结果数
ARXIV_MAX_RESULTS_PER_QUERY=30
# 请求超时 ms
ARXIV_REQUEST_TIMEOUT_MS=20000
# 最大重试次数（上限 2）
ARXIV_MAX_RETRIES=2
# 两次请求之间的最小间隔 ms（arXiv 官方建议 ≥3s）
ARXIV_REQUEST_INTERVAL_MS=3000

# ---- AI Provider（统一抽象层，阶段 1.5：腾讯 TokenHub OpenAI 兼容接口）----
# 业务代码通过 src/lib/ai/provider.ts 抽象访问，禁止直接绑定具体 SDK。
# AI_BASE_URL 接受以 /v1 结尾的 OpenAI 兼容地址（如 https://api.hunyuan.cloud.tencent.com/v1）。
# 密钥仅服务端读取，禁止输出到日志 / API 响应 / 客户端。
AI_PROVIDER=tencent
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
# 请求超时 ms
AI_REQUEST_TIMEOUT_MS=60000
# 最大重试次数（上限 2）
AI_MAX_RETRIES=2
# 每次运行最多分析条目数
AI_ANALYSIS_BATCH_SIZE=10
# 分析并发数（默认串行）
AI_ANALYSIS_CONCURRENCY=1
# 模型输入最大字符数
AI_MAX_INPUT_CHARS=12000
# 采样温度（结构化输出宜偏低）
AI_TEMPERATURE=0.2

# ---- 应用 ----
APP_BASE_URL=http://localhost:3000
COLLECTION_TIMEZONE=Asia/Shanghai
# 每日 AI 分析条目上限（成本控制）
AI_DAILY_TOP_N=30

# ---- Feed 数据模式（阶段 1.6）----
# fixture：使用内置演示数据，不访问数据库（开发默认）
# supabase：查询真实数据库（生产默认；未配置环境变量时页面显示清晰错误，不悄悄回退 fixture）
FRONTIER_DATA_MODE=fixture

# ---- Cron 鉴权（阶段 1.7）----
# 所有 /api/cron/* 必须携带 Authorization: Bearer <CRON_SECRET> 才能运行
CRON_SECRET=
